# Copiar a .env para cambiar la configuración. Las variables VITE_* quedan
# visibles en el bundle del navegador: no poner secretos acá.
# Reiniciar `npm run dev` después de modificarlas.

# URL base de la API (opcional, por defecto http://localhost:3001/api).
# La de producción está en .env.production (solo la usa `npm run build`, el de Vercel incluido).
# Se lee al hacer el build: si cambia, redesplegar.
VITE_API_URL=http://localhost:3001/api
