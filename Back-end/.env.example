# Copiar a .env y completar. El archivo .env no se sube al repositorio.

# Puerto de la API (opcional, por defecto 3001). Si lo cambiás, ajustá
# VITE_API_URL en Front-end/odontologia-marcos-garcia/.env
PORT=3001

# Base de datos en Turso: URL (libsql://…) y token, del panel de Turso o con
#   turso db show <base> --url
#   turso db tokens create <base>
# Sin TURSO_DATABASE_URL se usa un archivo local (Back-end/odontologia.db).
# En Vercel estas variables (y JWT_SECRET) van en Settings → Environment Variables.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Secreto para firmar los tokens de sesión. Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Zona horaria de la clínica (opcional, por defecto America/Caracas). Define qué hora
# es "ahora" para marcar como COMPLETADA las citas que ya terminaron.
# CLINIC_TZ=America/Caracas
